{
  "$schema": "https://datapackage.org/profiles/2.0/datapackage.json",
  "name": "osint-rondonia-catalogo-relacional",
  "title": "Catálogo OSINT Rondônia — tabelas relacionais",
  "description": "Catálogo de fichas OSINT de Rondônia em CSV relacionais, com hierarquia de portais, sites publicadores e instituições responsáveis. Recortes temáticos são definidos pela aplicação sobre categorias. Dados de terceiros mantêm as condições e licenças declaradas em suas fontes; a licença AGPL do repositório aplica-se ao código. O token \\N representa valor nulo; strings vazias permanecem distintas.",
  "homepage": "https://github.com/Rondoscopio/osint-rondonia",
  "version": "1.1.0",
  "profile": "data-package",
